# ---- Django core ----
DJANGO_SECRET_KEY=change-me-generate-a-new-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- CORS (frontend origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Gemini (Phase 6) — free key: https://aistudio.google.com/apikey ----
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Primary model 503/429 de to ye models try hote hain (comma-separated).
# Har model ka apna daily free bucket hota hai — failover se effective quota badhta hai.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=30

# ---- Upload limits (MB) ----
MAX_IMAGE_MB=10
MAX_AUDIO_MB=15
MAX_VIDEO_MB=25
